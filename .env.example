# Backend-only configuration. Never prefix keys with VITE_. No model is downloaded.
PLANNER_PORT=5180
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Fill with an exact model ID you have already installed/loaded.
LLM_MODEL=
# Optional comma-separated allowlist overrides LLM_MODEL. Maximum eight IDs.
LLM_MODELS=
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_JSON_MODE=true
# Remote providers require explicit opt-in and HTTPS; keys stay on the backend.
LLM_ALLOW_REMOTE=false
APP_ORIGINS=http://127.0.0.1:5175,http://127.0.0.1:5173

# Provider selection: compatible keeps local Ollama; gemini uses Google's native REST API.
LLM_PROVIDER=compatible
PLANNER_MODE=local
GEMINI_API_KEY=
# Exact account-verified ID, no models/ prefix. No hard-coded obsolete model default.
GEMINI_MODEL=
# Hosted mode requires Gemini, exact HTTPS APP_ORIGINS, secure quota settings and opt-in.
PUBLIC_AI_ENABLED=false
PUBLIC_AI_DAILY_LIMIT=100
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
